# [모드 전환 스위치]
# thick : 구형 DB (10g, 11g) 접속용 (라이브러리 필요)
# thin  : 신형 DB (19c 이상) 접속용 (라이브러리 불필요)
ORACLE_CLIENT_MODE=thick

ORACLE_SECRET_KEY=# Oracle DB 접속 정보 암호화/복호화시에 사용되는 비밀 키 (랜덤 문자열로 설정)
ORACLE_DB_USER=# Oracle DB 사용자 이름 (암호화된 값)
ORACLE_DB_PASSWORD=# Oracle DB 비밀번호 (암호화된 값)
ORACLE_DSN=# Oracle DB DSN (암호화된 값)

TIBERO_SECRET_KEY=# TIBERO DB 접속 정보 암호화/복호화시에 사용되는 비밀 키 (랜덤 문자열로 설정)
TIBERO_DB_USER=# TIBERO DB 사용자 이름 (암호화된 값)
TIBERO_DB_PASSWORD=# TIBERO DB 비밀번호 (암호화된 값)
TIBERO_DB_DSN=# TIBERO DB DSN (암호화된 값)

MARIADB_SECRET_KEY=# MariaDB 접속 정보 암호화/복호화시에 사용되는 비밀 키 (랜덤 문자열로 설정)
MYSQL_ROOT_PASSWORD_ENC=# MariaDB 루트 사용자 비밀번호 (암호화된 값)
DB_USER_ENC=# MariaDB 사용자 이름 (암호화된 값)
DB_PASS_ENC=# DB 비밀번호 (암호화된 값)
DB_HOST_ENC=# DB 호스트 (암호화된 값)
DB_NAME_ENC=# DB 이름 (암호화된 값)
DB_PORT=3306

LOCAL_DEV=true